/* Marmot: colours come from the active theme (ctrl+p -> "Change theme"). */

Screen {
    background: $background;
}

TabPane {
    padding: 1 2;
}

/* ---- shared ---------------------------------------------------------- */

Card {
    border: round $panel-lighten-2;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    height: auto;
    background: $surface;
}

.log-card {
    height: 1fr;
    min-height: 6;
}

.log-card RichLog {
    background: $surface;
    scrollbar-size-vertical: 1;
}

.button-row {
    height: auto;
    margin-top: 1;
}

.button-row Button {
    margin-right: 1;
    min-width: 12;
}

SelectionList {
    border: none;
    padding: 0;
    background: $surface;
    height: auto;
}

/* ---- monitor --------------------------------------------------------- */

#monitor-grid {
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: auto auto 1fr;
    grid-gutter: 1 2;
    height: 1fr;
}

#monitor-grid Card {
    height: 100%;
    min-height: 7;
}

#disk-card {
    height: auto;
}

Sparkline {
    height: 3;
    margin-top: 1;
}

#cpu-spark > .sparkline--max-color {
    color: $warning;
}

#cpu-spark > .sparkline--min-color {
    color: $success;
}

#net-spark > .sparkline--max-color {
    color: $accent;
}

#disk-card {
    column-span: 2;
}

#proc-card {
    column-span: 3;
}

#proc-table {
    height: 1fr;
    background: $surface;
}

/* ---- cleaner --------------------------------------------------------- */

#clean-left {
    width: 3fr;
    padding-right: 2;
}

#clean-right {
    width: 2fr;
}

#clean-items-card SelectionList {
    max-height: 14;
}

#clean-cache-card {
    height: 1fr;
    min-height: 5;
}

#clean-cache-card SelectionList {
    height: 1fr;
}

#chk-use-trash {
    margin-top: 1;
    background: transparent;
    border: none;
}

#clean-summary {
    padding: 1 0;
}

/* ---- uninstaller ----------------------------------------------------- */

#un-left {
    width: 2fr;
    padding-right: 2;
}

#un-right {
    width: 3fr;
}

#lbl-package-count {
    margin: 0 1 1 1;
}

#list-packages {
    height: 1fr;
    background: $surface;
    border: round $panel-lighten-2;
}

#lbl-uninstall-info {
    padding: 1 0;
}

#list-uninstall-remnants {
    max-height: 8;
    margin-top: 1;
    border: round $warning 50%;
}

#btn-uninstall-purge {
    margin: 1 0;
}

/* ---- analyzer -------------------------------------------------------- */

#analyzer-toolbar {
    height: auto;
    margin-bottom: 1;
}

#lbl-analyzer-path {
    width: 1fr;
    padding: 1 1 0 1;
}

#analyzer-toolbar Button {
    margin-left: 1;
    min-width: 10;
}

#list-analyzer {
    height: 1fr;
    background: $surface;
    border: round $panel-lighten-2;
}

#analyzer-hint {
    margin-top: 1;
}

/* ---- optimizer ------------------------------------------------------- */

#opt-list {
    height: 1fr;
}

.opt-row {
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
    background: $surface;
    border-left: thick $accent;
}

.opt-text {
    width: 1fr;
    height: auto;
}

.opt-status {
    margin-top: 0;
}

.opt-row Button {
    margin-left: 2;
    min-width: 10;
}

#opt-log-card {
    height: 8;
    min-height: 8;
}

#pane-optimizer .button-row {
    margin: 0 0 1 0;
}

/* ---- confirm dialog -------------------------------------------------- */

ConfirmScreen {
    align: center middle;
    background: $background 60%;
}

#confirm-box {
    width: 64;
    height: auto;
    padding: 1 2;
    border: thick $error 60%;
    background: $surface;
}

#confirm-msg {
    margin-bottom: 1;
}
